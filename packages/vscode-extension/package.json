{
  "name": "andy-agent-vscode",
  "displayName": "Andy Agent - Multi-Agent AI",
  "description": "Extensión oficial de Andy Agent para VS Code. Soporte nativo para escuadrones multi-agente, modificación local de archivos y consola.",
  "version": "0.8.0",
  "publisher": "andy-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/drexc/Andy-Agent.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Snippets"
  ],
  "icon": "resources/andy-icon.png",
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "andy-agent-container",
          "title": "Andy Agent",
          "icon": "resources/andy-icon.svg"
        }
      ]
    },
    "views": {
      "andy-agent-container": [
        {
          "type": "webview",
          "id": "andy-agent-sidebar-view",
          "name": "Andy Agent Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "andyAgent.openSidebar",
        "title": "Andy Agent: Abrir Chat",
        "category": "Andy Agent"
      },
      {
        "command": "andyAgent.newChat",
        "title": "Andy Agent: Nueva Conversación",
        "category": "Andy Agent"
      },
      {
        "command": "andyAgent.refactorSelection",
        "title": "Andy Agent: Refactorizar Código Seleccionado",
        "category": "Andy Agent"
      }
    ],
    "configuration": {
      "title": "Andy Agent",
      "properties": {
        "andyAgent.serverUrl": {
          "type": "string",
          "default": "http://localhost:20208",
          "description": "URL base del servidor Andy Agent (ej: http://localhost:20208 o http://192.168.1.50:20208)"
        },
        "andyAgent.apiKey": {
          "type": "string",
          "default": "andy_sk_55601891f34dd81e055839650f39e028c264983d2bd6d8d8",
          "description": "API Key de autenticación para Andy Agent"
        },
        "andyAgent.defaultTarget": {
          "type": "string",
          "default": "squad:dev-team-squad",
          "description": "Escuadrón o modelo por defecto (ej: squad:dev-team-squad, squad:fullstack-squad o auto/best-coding)"
        },
        "andyAgent.autoApplyChanges": {
          "type": "boolean",
          "default": true,
          "description": "Si está activado, los archivos generados se guardan automáticamente en tu espacio de trabajo local de VS Code."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.0"
  }
}
